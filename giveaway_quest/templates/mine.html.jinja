{% extends "base.html.jinja" %} {% block title %}My giveaways · {{ site_name
}}{% endblock %} {% block content %}
<h1 class="text-3xl font-bold mb-6">My giveaways &amp; entries</h1>

<section class="mb-8">
    <div class="flex items-center justify-between mb-3">
        <h2 class="text-xl font-semibold">Hosting</h2>
        <a href="/new" class="btn btn-sm btn-primary">+ New</a>
    </div>
    {% if hosting %}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for g in hosting %}{% include "_card.html.jinja" %}{% endfor %}
    </div>
    {% else %}
    <p class="text-base-content/70">You haven't hosted anything yet.</p>
    {% endif %}
</section>

<section>
    <h2 class="text-xl font-semibold mb-3">Entered</h2>
    {% if entered %}
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {% for g in entered %}{% include "_card.html.jinja" %}{% endfor %}
    </div>
    {% else %}
    <p class="text-base-content/70">You haven't entered any giveaways yet.</p>
    {% endif %}
</section>
{% endblock %}
