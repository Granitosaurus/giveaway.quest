{% from "_icons.html.jinja" import quest_marker %} {% set st = status_of(g) %}
<a
    href="/{{ g.slug }}"
    class="card bg-base-100 shadow-sm hover:shadow-md transition-shadow"
>
    <div class="card-body gap-2">
        <div class="flex items-start justify-between gap-2">
            <h2 class="card-title text-base leading-snug font-quest">
                {{ quest_marker(st, "inline-block w-4 h-4 shrink-0
                drop-shadow-sm align-[-0.15em]") }} {{ g.title }}
            </h2>
            {% if st == 'open' %}
            <span class="badge badge-success badge-sm whitespace-nowrap"
                >{{ g.ends_at | remaining }}</span
            >
            {% elif st == 'drawing' %}
            <span class="badge badge-warning badge-sm whitespace-nowrap"
                >drawing…</span
            >
            {% else %}
            <span class="badge badge-ghost badge-sm whitespace-nowrap"
                >ended</span
            >
            {% endif %}
        </div>
        {% if g.quest %}
        <p class="text-sm">{{ g.quest | truncate(120) }}</p>
        {% endif %}
        <div
            class="flex items-center gap-2 text-xs text-base-content/70 mt-auto"
        >
            {% if g.owner_avatar %}<img
                src="{{ g.owner_avatar }}"
                alt=""
                class="w-5 h-5 rounded-full"
            />{% endif %}
            <span class="truncate">@{{ g.owner_acct }}</span>
            <span class="ml-auto whitespace-nowrap"
                >{{ g.entry_count }} {{ 'entry' if g.entry_count == 1 else
                'entries' }}</span
            >
        </div>
    </div>
</a>
