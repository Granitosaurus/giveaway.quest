<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{% block title %}{{ site_name }}{% endblock %}</title>
        <meta
            name="description"
            content="{% block description %}Give away spare game keys and other digital codes to real Fediverse people. Log in with Mastodon, add a little quest, let the site pick a winner.{% endblock %}"
        />
        <link rel="canonical" href="{{ base_url }}{{ path }}" />
        <link rel="stylesheet" href="/static/app.css?v={{ version }}" />
        <link rel="icon" href="/static/icons/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/static/icons/favicon.svg" type="image/svg+xml" />
        <link
            rel="icon"
            href="/static/icons/favicon-16x16.png"
            type="image/png"
            sizes="16x16"
        />
        <link
            rel="icon"
            href="/static/icons/favicon-32x32.png"
            type="image/png"
            sizes="32x32"
        />
        <link
            rel="icon"
            href="/static/icons/favicon-48x48.png"
            type="image/png"
            sizes="48x48"
        />
        <link
            rel="apple-touch-icon"
            href="/static/icons/favicon-180x180.png"
        />
        <link
            rel="mask-icon"
            href="/static/icons/favicon.svg"
            color="#9a7b4f"
        />
        <link rel="manifest" href="/static/site.webmanifest" />
        <meta
            name="theme-color"
            media="(prefers-color-scheme: light)"
            content="#ffffff"
        />
        <meta
            name="theme-color"
            media="(prefers-color-scheme: dark)"
            content="#1d232a"
        />
        <!-- Blocking on purpose: applies a saved theme before first paint. External (not inline) so the CSP can stay script-src 'self'. -->
        <script src="/static/theme.js?v={{ version }}"></script>
        {# Site identity for search engines. Not executed, so script-src 'self' does not apply. #}
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "Organization",
                        "@id": {{ (base_url ~ "/#org") | tojson }},
                        "name": {{ site_name | tojson }},
                        "url": {{ (base_url ~ "/") | tojson }},
                        "logo": {{ (base_url ~ "/static/icons/favicon-512x512.png") | tojson }},
                        "sameAs": ["https://fosstodon.org/@giveaway_quest"]
                    },
                    {
                        "@type": "WebSite",
                        "@id": {{ (base_url ~ "/#website") | tojson }},
                        "name": {{ site_name | tojson }},
                        "url": {{ (base_url ~ "/") | tojson }},
                        "publisher": { "@id": {{ (base_url ~ "/#org") | tojson }} }
                    }
                ]
            }
        </script>
        {% block head %}{% endblock %}
    </head>
    <body class="min-h-screen flex flex-col bg-base-200">
        <header class="navbar bg-base-100 shadow-sm">
            <div class="container mx-auto max-w-5xl flex items-center px-2">
                <a
                    href="/"
                    class="btn btn-ghost text-xl font-bold tracking-tight font-quest"
                    ><img class="h-6 w-6" src="/static/icons/favicon.svg"/> <span class="hidden min-[400px]:inline"
                        >{{ site_name }}</span
                    ></a
                >
                <div class="ml-auto flex items-center gap-2">
                    <label
                        class="swap swap-rotate btn btn-ghost btn-circle btn-sm"
                        title="Toggle light / dark"
                    >
                        <input
                            type="checkbox"
                            data-theme-toggle
                            aria-label="Toggle light and dark theme"
                        />
                        <svg
                            class="swap-off w-5 h-5"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="12" cy="12" r="4"></circle>
                            <path
                                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                            ></path>
                        </svg>
                        <svg
                            class="swap-on w-5 h-5"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                            ></path>
                        </svg>
                    </label>

                    <div class="hidden sm:flex items-center gap-2">
                        <a href="/new" class="btn btn-primary btn-sm"
                            >+ New giveaway</a
                        >
                        {% if user %}
                        <div class="dropdown dropdown-end">
                            <div
                                tabindex="0"
                                role="button"
                                class="btn btn-ghost btn-sm gap-2"
                            >
                                {% if user.avatar_url %}<img
                                    src="{{ user.avatar_url }}"
                                    alt=""
                                    class="w-6 h-6 rounded-full"
                                />{% endif %}
                                <span class="max-w-40 truncate"
                                    >{{ user.display_name }}</span
                                >
                            </div>
                            <ul
                                tabindex="0"
                                class="dropdown-content menu bg-base-100 rounded-box z-10 w-56 p-2 shadow"
                            >
                                <li class="menu-title truncate">
                                    @{{ user.acct }}
                                </li>
                                <li>
                                    <a href="/mine"
                                        >My giveaways &amp; entries</a
                                    >
                                </li>
                                <li>
                                    <a
                                        href="{{ user.profile_url }}"
                                        rel="noopener"
                                        >Mastodon profile</a
                                    >
                                </li>
                                <li>
                                    <form method="post" action="/auth/logout">
                                        {{ csrf_input | safe }}<button
                                            type="submit"
                                        >
                                            Log out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                        {% else %}
                        <a
                            href="/auth/login?next={{ path }}"
                            class="btn btn-ghost btn-sm"
                            >Log in with Mastodon</a
                        >
                        {% endif %}
                    </div>

                    <div class="dropdown dropdown-end sm:hidden">
                        <div
                            tabindex="0"
                            role="button"
                            class="btn btn-ghost btn-square btn-sm"
                            aria-label="Open menu"
                        >
                            <svg
                                class="w-5 h-5"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <line x1="4" y1="6" x2="20" y2="6"></line>
                                <line x1="4" y1="12" x2="20" y2="12"></line>
                                <line x1="4" y1="18" x2="20" y2="18"></line>
                            </svg>
                        </div>
                        <ul
                            tabindex="0"
                            class="dropdown-content menu bg-base-100 rounded-box z-10 w-56 p-2 shadow"
                        >
                            <li><a href="/new">+ New giveaway</a></li>
                            {% if user %}
                            <li class="menu-title truncate">
                                @{{ user.acct }}
                            </li>
                            <li>
                                <a href="/mine">My giveaways &amp; entries</a>
                            </li>
                            <li>
                                <a href="{{ user.profile_url }}" rel="noopener"
                                    >Mastodon profile</a
                                >
                            </li>
                            <li>
                                <form method="post" action="/auth/logout">
                                    {{ csrf_input | safe }}<button
                                        type="submit"
                                    >
                                        Log out
                                    </button>
                                </form>
                            </li>
                            {% else %}
                            <li>
                                <a href="/auth/login?next={{ path }}"
                                    >Log in with Mastodon</a
                                >
                            </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <main class="container mx-auto max-w-5xl px-4 py-6 flex-1 w-full">
            {% for f in flashes %}
            <div
                role="alert"
                class="alert alert-{{ f.kind if f.kind in ['success','error','warning'] else 'info' }} mb-4"
            >
                <span>{{ f.message }}</span>
            </div>
            {% endfor %} {% block content %}{% endblock %}
        </main>

        <footer
            class="footer footer-center bg-base-100 text-base-content/70 p-6 text-sm"
        >
            <p class="flex flex-wrap justify-center gap-x-1.5 gap-y-1">
                {{ site_name }} · share with Fediverse ·
		<a class="link" rel="me" href="https://fosstodon.org/@giveaway_quest">@giveaway_quest</a>  ·
                <a class="link" href="https://github.com/Granitosaurus/giveaway.quest">source code</a> ·
                <a class="link" href="https://fosstodon.org/@wraptile">by @wraptile</a> ·
                <a class="link" href="https://github.com/Granitosaurus/giveaway.quest/tags">v{{ version }}</a>
            </p>
        </footer>

        <script src="/static/app.js?v={{ version }}"></script>
    </body>
</html>
