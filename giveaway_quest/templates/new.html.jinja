{% extends "base.html.jinja" %}
{% from "_forms.html.jinja" import md_editor, winner_fields %}
{% block title %}New giveaway · {{ site_name }}{% endblock %}
{% block content %}
<h1 class="text-3xl font-bold mb-2">New giveaway</h1>
<p class="text-base-content/70 mb-6">
    Rewards stay secret on {{ site_name }} and are shown only to their winner.
    Everything else is public.
</p>

<form method="post" action="/new" class="grid gap-6 lg:grid-cols-3">
    {{ csrf_input | safe }}
    <div class="min-w-0 lg:col-span-2 space-y-4">
        <fieldset class="fieldset bg-base-100 rounded-box shadow-sm p-5 gap-4">
            <legend class="fieldset-legend">What are you giving away?</legend>
            <label class="floating-label">
                <span>Title</span>
                <input
                    name="title"
                    class="input w-full"
                    required
                    maxlength="120"
                    placeholder="Psychonauts 2 (Steam)"
                    value="{{ form.title or '' }}"
                />
            </label>

            {{ md_editor(
                "quest",
                "Quest (optional, the fun part)",
                form.quest or "",
                rows=3,
                placeholder="Pet a cat. Take a 20 minute walk. Draw a duck."
            ) }}

            {{ winner_fields(rewards=rewards, count=count, max_winners=max_winners) }}
        </fieldset>

        <p class="text-sm text-base-content/60">
            {{ site_name }} never posts as you. After you create the giveaway
            you'll get a
            <strong>Share on Mastodon</strong> button that opens a compose box
            pre-filled on your own server.
        </p>
    </div>

    <div class="min-w-0 space-y-4">
        <fieldset class="fieldset bg-base-100 rounded-box shadow-sm p-5 gap-4">
            <legend class="fieldset-legend">Rules</legend>
            <label class="floating-label">
                <span>Conditions participants must agree to (optional)</span>
                <textarea
                    name="conditions"
                    class="textarea w-full"
                    rows="3"
                    maxlength="2000"
                    placeholder="Region locked to EU. Please only enter if you'll actually play it."
                >
{{ form.conditions or '' }}</textarea>
            </label>
            <label class="floating-label">
                <span>Runs for (hours)</span>
                <input
                    name="hours"
                    type="number"
                    class="input w-full"
                    min="1"
                    max="2160"
                    required
                    value="{{ form.hours or 72 }}"
                />
            </label>
            <p class="label whitespace-normal">
                24 = one day, 72 = three days, 168 = a week. Winners are drawn
                automatically.
            </p>
            <label class="floating-label">
                <span>Only accounts on these servers (optional)</span>
                <input
                    name="allowed_instances"
                    class="input w-full"
                    placeholder="fosstodon.org, mastodon.social"
                    value="{{ form.allowed_instances or '' }}"
                />
            </label>
            <label class="floating-label">
                <span>Minimum account age (days)</span>
                <input
                    name="min_account_age_days"
                    type="number"
                    class="input w-full"
                    min="0"
                    max="3650"
                    value="{{ form.min_account_age_days or 0 }}"
                />
            </label>
            <label class="label cursor-pointer justify-start gap-3">
                <input
                    type="checkbox"
                    name="listed"
                    class="checkbox"
                    {% if form.listed == 'on' %}checked{% endif %}
                />
                <span>Show on the {{ site_name }} front page</span>
            </label>
            <label class="label cursor-pointer items-start justify-start gap-3 whitespace-normal">
                <input
                    type="checkbox"
                    name="restart_if_unclaimed"
                    class="checkbox mt-0.5"
                    {% if form.restart_if_unclaimed == 'on' %}checked{% endif %}
                />
                <span
                    >Restart if unclaimed &mdash; if a winner doesn't claim
                    their reward within 2 days, re-draw that seat among the
                    other entrants (or reopen the giveaway if nobody's
                    left).</span
                >
            </label>
        </fieldset>
        <button class="btn btn-primary w-full btn-lg">Create giveaway</button>
    </div>
</form>
{% endblock %}
