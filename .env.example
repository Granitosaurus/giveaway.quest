# Public base URL of the site (used for OAuth redirects, links in posts, sitemap).
GQ_BASE_URL=http://localhost:8000
# Random secret for signing session cookies. Generate with: python -c 'import secrets;print(secrets.token_hex(32))'
GQ_SECRET_KEY=change-me
# Where the sqlite database and backups live.
GQ_DATA_DIR=./data
# Set to 1 for debug tracebacks.
GQ_DEBUG=1
# Optional: comma separated list of accounts (user@instance) with admin rights on the website.
GQ_ADMINS=
# The site's own Mastodon account, used to announce giveaways (`gq announce <slug>`),
# to DM winners, and to read the announcement's reply thread for the on-page
# comments. Create an app token on that account with the `write:statuses` and
# `read:statuses` scopes (Preferences -> Development -> New application). Leave
# blank to disable all three.
GQ_ANNOUNCE_INSTANCE=
GQ_ANNOUNCE_TOKEN=
# Show replies to a giveaway's announcement post as comments on its page. Needs
# GQ_ANNOUNCE_* above (with read:statuses). Set to 0 to turn comments off.
GQ_COMMENTS=1
# Auto-post an announcement from the site's account for every *listed* giveaway
# (a background pass; also what opens its comment thread). Set to 0 to keep
# `gq announce <slug>` the only way.
GQ_AUTO_ANNOUNCE=1
# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels -> your
# tunnel -> the "Docker" install command has it). Used by docker-compose.yml's
# cloudflared service; not read by the app itself.
CLOUDFLARE_TUNNEL_TOKEN=
# Optional: rclone remote (as "remote:path") to sync data/backups to after
# each hourly snapshot -- see tasks.py's backup task. Read host-side by
# `uv run invoke backup`, via EnvironmentFile= on
# deploy/giveaway-quest-backup.service, not by the app. On the
# homek14/homek15 pair this points at the other box over SFTP using the
# already-trusted dex SSH key (see ~/.config/rclone/rclone.conf), e.g.
# BACKUP_RCLONE_REMOTE=homek14:backups/giveaway-quest
BACKUP_RCLONE_REMOTE=
