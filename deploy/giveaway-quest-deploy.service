[Unit]
Description=Deploy the newest giveaway.quest release tag, if not already running
After=giveaway-quest-compose.service

[Service]
Type=oneshot
WorkingDirectory=%h/projects/giveaway-quest
EnvironmentFile=%h/projects/giveaway-quest/.env
ExecStart=/run/current-system/sw/bin/uv run invoke deploy
TimeoutStartSec=900
